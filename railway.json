{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements_deploy.txt && python -m spacy download en_core_web_sm"
  },
  "deploy": {
    "startCommand": "gunicorn webapp:app --bind 0.0.0.0:$PORT",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
